{
  "name": "@knowme/dsh-bridge",
  "description": "B3-small wire-bridge cordis plugin: exposes the interaction-control methods (selectModel / approval-respond / question-respond) the DeepSeek Harness stdio SDK surface omits, so an out-of-process host (KnowMe) can drive dsh without restarting the runtime.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Timeflys2018",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Timeflys2018/knowme-dsh-bridge.git"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.example.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:contract": "node verify/verify-contract.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-sdk-protocol": "^0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": { "optional": false },
    "@deepseek-ai/dsh-session": { "optional": false }
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "dsh": {
    "plugin": true
  }
}
